#: org_qubes_os_initial_setup/gui/spokes/qubes_os.glade:10
msgid "QUBES OS"
msgstr "QUBES OS"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.glade:65
msgid "Templates Configuration"
msgstr "הגדרת תבניות"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.glade:85
msgid "Installation:"
msgstr "התקנה:"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.glade:135
msgid "Main Configuration"
msgstr "הגדרות עיקריות"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.glade:193
msgid "Advanced Configuration"
msgstr "הגדרות מתקדמות"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:225
msgid "Default:"
msgstr "ברירת מחדל:"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:280
msgid "Create 'vm-pool' LVM thin pool"
msgstr "יצירת מאגר thin של LVM בשם 'vm-pool'"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:285
msgid "Use existing LVM thin pool"
msgstr "שימוש במאגר thin קיים של LVM"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:316
msgid "LVM Volume Group:"
msgstr "‏Volume Group של LVM:"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:321
msgid "LVM Thin Pool:"
msgstr "מאגר thin של LVM:"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:405
msgid "_QUBES OS"
msgstr "_QUBES OS"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:462
msgid "Whonix not available"
msgstr "‏Whonix לא זמין"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:476
#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:123
msgid "Create default system qubes (sys-net, sys-firewall, default DispVM)"
msgstr ""
"יצירת qubes מערכת כברירת מחדל (sys-net, sys-firewall, DispVM ברירת המחדל)"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:483
#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:130
msgid "Make sys-firewall and sys-usb disposable"
msgstr "הפיכת sys-firewall ו-sys-usb ל-qubes זמניים"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:490
#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:135
msgid "Make sys-net disposable"
msgstr "הפיכת sys-net ל-qube זמני"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:499
#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:141
msgid "Preload disposable qubes based on the default DispVM (faster usage)"
msgstr ""
"טעינה מראש של qubes זמניים המבוססים על DispVM ברירת המחדל (לשימוש מהיר יותר)"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:507
msgid "Preloading disposables not available (not enough memory)"
msgstr "טעינה מראש של qubes זמניים לא זמינה (אין מספיק זיכרון)"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:514
#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:149
msgid "Create default application qubes (personal, work, untrusted, vault)"
msgstr "יצירת qubes יישומים כברירת מחדל (personal, work, untrusted, vault)"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:523
msgid ""
"Use a qube to hold all USB controllers (create a new qube called sys-usb by "
"default)"
msgstr ""
"שימוש ב-qube שיחזיק את כל בקרי ה-USB (כברירת מחדל ייווצר qube חדש בשם sys-"
"usb)"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:530
msgid "USB qube configuration disabled - you are using USB disk"
msgstr "הגדרת ה-qube של USB מושבתת - המערכת מותקנת על דיסק USB"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:535
#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:180
msgid "Use sys-net qube for both networking and USB devices"
msgstr "שימוש ב-qube sys-net גם לרשת וגם להתקני USB"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:541
#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:186
msgid "Automatically accept USB mice (discouraged)"
msgstr "קבלה אוטומטית של עכברי USB (לא מומלץ)"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:548
msgid ""
"Automatically accept USB keyboard (discouraged if non-USB keyboard is "
"available)"
msgstr "קבלה אוטומטית של מקלדת USB (לא מומלץ אם יש מקלדת שאינה USB)"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:563
#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:157
msgid "Create Whonix Gateway and Workstation qubes (sys-whonix, anon-whonix)"
msgstr "יצירת qubes של Whonix Gateway ו-Workstation (sys-whonix, anon-whonix)"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:574
#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:166
msgid ""
"Enable system and template updates over the Tor anonymity network using "
"Whonix"
msgstr "הפעלת עדכוני מערכת ותבניות דרך רשת האנונימיות Tor באמצעות Whonix"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:605
msgid "Do not configure anything (for advanced users)"
msgstr "לא להגדיר דבר (למשתמשים מתקדמים)"

#: org_qubes_os_initial_setup/gui/spokes/qubes_os.py:704
msgid ""
"<b>INFO:</b> the following USB keyboards will be connected to sys-usb:\n"
"{}\n"
"<b>If you disable the option above, they will not function in Qubes.</b>"
msgstr ""
"<b>מידע:</b> מקלדות ה-USB הבאות יחוברו ל-sys-usb:\n"
"‏{}\n"
"<b>אם תבטל את האפשרות שלמעלה, הן לא יפעלו ב-Qubes.</b>"

#: org_qubes_os_initial_setup/service/tasks.py:73
msgid "Setup up default kernel"
msgstr "הגדרת ליבת ברירת המחדל"

#: org_qubes_os_initial_setup/service/tasks.py:92
msgid "Setup up default storage pool"
msgstr "הגדרת מאגר האחסון של ברירת המחדל"

#: org_qubes_os_initial_setup/service/tasks.py:105
msgid "Cannot find default LVM volume group"
msgstr "לא נמצאה Volume Group של LVM כברירת מחדל"

#: org_qubes_os_initial_setup/service/tasks.py:152
#, python-format
msgid "Install template %s"
msgstr "התקנת התבנית %s"

#: org_qubes_os_initial_setup/service/tasks.py:157
#, python-format
msgid "Installing TemplateVM %s"
msgstr "מתקין את התבנית %s"

#: org_qubes_os_initial_setup/service/tasks.py:165
msgid "Setting up default pool"
msgstr "הגדרת מאגר ברירת המחדל"

#: org_qubes_os_initial_setup/service/tasks.py:176
msgid "Setup up administration VM (dom0)"
msgstr "הגדרת qube הניהול (dom0)"

#: org_qubes_os_initial_setup/service/tasks.py:196
msgid "Setup default template"
msgstr "הגדרת תבנית ברירת המחדל"

#: org_qubes_os_initial_setup/service/tasks.py:235
msgid "Executing qubes configuration"
msgstr "ביצוע הגדרת ה-qubes"

#: org_qubes_os_initial_setup/service/tasks.py:298
msgid ""
"Qubes initial configuration failed. Login to the system and check /var/log/"
"salt/minion for details. You can retry configuration by calling 'sudo "
"qubesctl --all state.highstate' in dom0 (you will get detailed state there)."
msgstr ""
"ההגדרה הראשונית של Qubes נכשלה. יש להתחבר למערכת ולבדוק את /var/log/salt/"
"minion לפרטים. אפשר לנסות שוב את ההגדרה בהרצת 'sudo qubesctl --all state."
"highstate' ב-dom0 (שם יוצג המצב המפורט)."

#: org_qubes_os_initial_setup/service/tasks.py:314
msgid "Create default DisposableVM"
msgstr "יצירת qube זמני כברירת מחדל"

#: org_qubes_os_initial_setup/service/tasks.py:332
msgid "Setup networking"
msgstr "הגדרת רשת"

#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:76
msgid "Qubes OS"
msgstr "Qubes OS"

#: org_qubes_os_initial_setup/tui/spokes/qubes_os.py:174
msgid "Create USB qube holding all USB controllers (sys-usb)"
msgstr "יצירת qube USB שמחזיק את כל בקרי ה-USB (sys-usb)"
